---
interface Props {
  t: {
    badges: string[];
  };
}

const { t } = Astro.props;
---

<div data-reveal class="w-full">
  <!-- Grilla en lugar de pills con flex-wrap: las columnas quedan alineadas aunque la última fila esté incompleta. -->
  <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2 text-left t-meta text-copy/70 dark:text-dark-muted" aria-label="Admin panel features">
    {t.badges.map((badge) => (
      <li class="flex items-baseline gap-2">
        <span class="admin-dot shrink-0 w-1.5 h-1.5 rounded-full translate-y-[-0.1em]" aria-hidden="true"></span>
        {badge}
      </li>
    ))}
  </ul>
</div>

<style>
  .admin-dot {
    background-color: var(--project-accent);
  }

  :global(.dark) .admin-dot {
    background-color: color-mix(in srgb, var(--project-accent) 60%, white);
  }
</style>
