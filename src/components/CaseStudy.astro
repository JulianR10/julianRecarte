---
import { Image } from "astro:assets";
import type { Project } from "@data/projects";
import AdminPanel from "./AdminPanel.astro";
import fondoTriba from "@assets/images/fondoTriba.webp";

interface Props {
  lang: string;
  project: Project;
  t: {
    backLabel: string;
    title: string;
    subtitle: string;
    challengeTitle: string;
    challenge: string;
    solutionTitle: string;
    solution: string;
    plusTitle?: string;
    plus?: string;
    adminPanel?: {
      badges: string[];
    };
  };
}

const { lang, project, t } = Astro.props;
const accent = project.accent;
const mobileMockup = project.mockupMobile ?? project.mockup;
---

<div class="relative" style={`--project-accent: ${accent}`}>
  <a
    href={`/${lang}/#proyectos`}
    data-lenis-prevent
    class="absolute left-6 md:left-8 top-24 md:top-28 z-30 flex items-center justify-center w-11 h-11 rounded-full bg-[var(--bg-hex)] dark:bg-dark-card backdrop-blur-lg shadow-lg transition-all duration-300 hover:scale-110 text-copy/70 dark:text-dark-copy/70 hover:text-accent-orange"
    aria-label={t.backLabel}
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  </a>

  <section
    class="case-hero relative px-6 pt-[calc(var(--navbar-h)+3rem)] pb-16 md:pt-[calc(var(--navbar-h)+4rem)] md:pb-24 lg:pb-28"
    style={`--project-accent: ${accent}; --project-style: ${project.style}`}
  >
    {project.slug === "triba" && (
      <>
        <Image
          src={fondoTriba}
          alt=""
          aria-hidden="true"
          class="case-bg absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="case-veil absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      </>
    )}
    <div class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_660px] gap-6 lg:gap-10 items-center">
      <div class="flex flex-col items-center text-center lg:text-left lg:items-start gap-6">
        <div class="flex flex-col items-center lg:items-start">
          {project.image && (
            <div data-reveal class="mb-5 flex justify-center lg:justify-start">
              {project.liveUrl ? (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.title} — visitar sitio`}
                  class="inline-flex hover:opacity-80 transition-opacity duration-300"
                >
                  <img
                    src={project.image.src}
                    alt={`${t.title} logo`}
                    class="h-14 md:h-16 w-auto object-contain"
                    loading="eager"
                    decoding="async"
                  />
                </a>
              ) : (
                <img
                  src={project.image.src}
                  alt={`${t.title} logo`}
                  class="h-14 md:h-16 w-auto object-contain"
                  loading="eager"
                  decoding="async"
                />
              )}
            </div>
          )}

          <h1 data-reveal class="t-h3 font-medium mb-2">
            {t.title}
          </h1>
          <p data-reveal class="t-body-lg max-w-2xl mx-auto lg:mx-0 text-copy/70 dark:text-dark-muted">
            {t.subtitle}
          </p>
        </div>

        {mobileMockup && (
          <div class="w-[320px] sm:w-[540px] mx-auto lg:hidden">
            <div data-reveal>
              <Image
                src={mobileMockup}
                alt={`${t.title} — mockups`}
                widths={[320, 540]}
                sizes="(min-width: 640px) 540px, 320px"
                loading="eager"
                decoding="async"
              />
            </div>
            {t.adminPanel && <AdminPanel t={t.adminPanel} />}
          </div>
        )}

        <div data-reveal class="w-full max-w-2xl mx-auto lg:mx-0 lg:w-auto">
          <h2 class="case-accent t-eyebrow mb-2">
            {t.challengeTitle}
          </h2>
          <p class="t-body text-copy/70 dark:text-dark-muted">
            {t.challenge}
          </p>
        </div>

        <div data-reveal class="w-full max-w-2xl mx-auto lg:mx-0 lg:w-auto">
          <h2 class="case-accent t-eyebrow mb-2">
            {t.solutionTitle}
          </h2>
          <p class="t-body text-copy/70 dark:text-dark-muted">
            {t.solution}
          </p>
        </div>

        {t.plus && t.plusTitle && (
          <div data-reveal class="w-full max-w-2xl mx-auto lg:mx-0 lg:w-auto">
            <h2 class="case-accent t-eyebrow mb-2">
              {t.plusTitle}
            </h2>
            <p class="t-body text-copy/70 dark:text-dark-muted">
              {t.plus}
            </p>
          </div>
        )}
      </div>

      {project.mockup && (
        <div data-reveal class="hidden lg:flex items-center justify-center py-8">
          <div class="w-full max-w-[660px] flex flex-col gap-6">
            <Image
              src={project.mockup}
              alt={`${t.title} — mockups`}
              widths={[660, 1000]}
              sizes="(min-width: 1024px) 660px"
              loading="eager"
              decoding="async"
              class="w-full h-auto"
            />
            {t.adminPanel && <AdminPanel t={t.adminPanel} />}
          </div>
        </div>
      )}

    </div>
  </section>
</div>

<style>
  .case-bg {
    opacity: 1;
  }
  :global(.dark) .case-bg {
    opacity: 0.38;
  }

  .case-veil {
    background: color-mix(in srgb, var(--bg-hex) 58%, transparent);
  }
  :global(.dark) .case-veil {
    background: color-mix(in srgb, var(--bg-hex) 86%, transparent);
  }

  .case-hero {
    background:
      radial-gradient(circle at 20% 25%, color-mix(in srgb, var(--project-accent) 20%, transparent), transparent 55%),
      radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--project-accent) 12%, transparent), transparent 50%),
      var(--project-style),
      var(--bg-hex);
  }

  .case-accent {
    color: var(--project-accent);
  }
  .case-accent.case-badge {
    border-color: color-mix(in srgb, var(--project-accent) 35%, transparent);
  }

  :global(.dark) .case-hero {
    background:
      radial-gradient(circle at 20% 25%, color-mix(in srgb, var(--project-accent) 14%, transparent), transparent 55%),
      radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--project-accent) 8%, transparent), transparent 50%),
      linear-gradient(rgba(22, 20, 18, 0.66), rgba(22, 20, 18, 0.66)),
      var(--project-style),
      var(--bg-hex);
  }

  :global(.dark) .case-accent {
    color: color-mix(in srgb, var(--project-accent) 60%, white);
  }
  :global(.dark) .case-accent.case-badge {
    border-color: color-mix(in srgb, var(--project-accent) 50%, white);
  }
</style>
