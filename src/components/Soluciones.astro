---
import SectionHeader from "./SectionHeader.astro";
import SectionFade from "./SectionFade.astro";

interface SolucionItem {
  title: string;
  description: string;
}

interface Props {
  t: {
    label: string;
    title: string;
    highlight: string;
    cta: string;
    hint: string;
    items: SolucionItem[];
  };
}

const { t } = Astro.props;
---

<section
  id="soluciones"
  class="relative z-[2] px-6 py-16 md:py-24"
  style="background-color: var(--bg-hex)"
>
  <SectionFade edge="top" />
  <div class="max-w-7xl mx-auto">
    <SectionHeader label={t.label} title={t.title} highlight={t.highlight} />

    <div class="max-w-7xl mx-auto" data-reveal-stagger>
      {t.items.map((item, i) => (
        <div
          class="group relative grid grid-cols-1 md:grid-cols-[300px_1fr] gap-3 md:gap-12 py-8 md:py-10"
        >
          <div data-solu-line aria-hidden="true" class="absolute top-0 left-0 right-0 h-px bg-black/[0.08] dark:bg-white/[0.08] origin-left"></div>
          {i === t.items.length - 1 && (
            <div data-solu-line aria-hidden="true" class="absolute bottom-0 left-0 right-0 h-px bg-black/[0.08] dark:bg-white/[0.08] origin-left"></div>
          )}
          <div class="flex flex-col gap-2">
            <span aria-hidden="true" class="text-xs font-medium tracking-[0.22em] text-copy/30 dark:text-dark-muted/40 tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="text-2xl md:text-3xl font-bold leading-tight tracking-tight bg-gradient-to-r from-accent-orange to-[#FFD8B9] bg-clip-text text-transparent">
              {item.title}
            </h3>
          </div>
          <p class="text-sm md:text-base leading-relaxed text-copy/60 dark:text-dark-muted" style="text-wrap: balance;">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <p class="text-center text-sm md:text-base italic text-copy/60 dark:text-dark-muted max-w-2xl mx-auto mt-10 md:mt-12" style="text-wrap: balance;" data-reveal>
      {t.hint}
    </p>

    <div class="flex justify-center mt-10 md:mt-12" data-reveal>
      <a
        href="#contacto"
        data-magnetic
        class="inline-flex items-center justify-center gap-2 w-auto px-6 py-3 md:px-8 md:py-4 bg-gradient-to-r from-accent-orange to-accent-pastel backdrop-blur-lg text-white rounded-full font-medium text-sm md:text-base tracking-wider uppercase shadow-lg"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>

<noscript><style>[data-solu-line]{transform:scaleX(1) !important}</style></noscript>
