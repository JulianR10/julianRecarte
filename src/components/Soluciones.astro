---
import Button from "@components/Button.astro";
import SectionHeader from "./SectionHeader.astro";

interface SolucionItem {
  title: string;
  description: string;
}

interface Props {
  t: {
    label: string;
    title: string;
    highlight: string;
    cta: string;
    hint: string;
    hintHighlight: string;
    items: SolucionItem[];
  };
}

const { t } = Astro.props;
---

<section
  id="soluciones"
  class="relative z-[2] px-6 py-16 md:py-24 bg-transparent"
>
  <div class="max-w-7xl mx-auto">
    <SectionHeader label={t.label} title={t.title} highlight={t.highlight} />

    <div class="max-w-7xl mx-auto" data-reveal-stagger>
      {t.items.map((item, i) => (
        <div
          class="group relative grid grid-cols-1 md:grid-cols-[300px_1fr] gap-3 md:gap-12 py-8 md:py-10"
        >
          <div data-solu-line aria-hidden="true" class="absolute top-0 left-0 right-0 h-px bg-black/[0.08] dark:bg-white/[0.08] origin-left"></div>
          {i === t.items.length - 1 && (
            <div data-solu-line aria-hidden="true" class="absolute bottom-0 left-0 right-0 h-px bg-black/[0.08] dark:bg-white/[0.08] origin-left"></div>
          )}
          <div class="flex flex-row items-baseline gap-3">
            <span aria-hidden="true" class="t-index text-copy/30 dark:text-dark-muted/40 shrink-0">
              {String(i + 1).padStart(2, "0")}.
            </span>
            <h3 class="t-h3 font-bold text-accent-deep">
              {item.title}
            </h3>
          </div>
          <p class="t-body text-copy/70 dark:text-dark-muted text-balance">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <p class="t-body text-center italic text-copy/70 dark:text-dark-muted max-w-2xl mx-auto mt-10 md:mt-12 text-balance" data-reveal>
      {t.hint}<span class="underline decoration-accent-orange decoration-2 underline-offset-4">{t.hintHighlight}</span>
    </p>

    <div class="flex justify-center mt-10 md:mt-12" data-reveal>
      <Button href="#contacto">{t.cta}</Button>
    </div>
  </div>
</section>

<noscript><style>[data-solu-line]{transform:scaleX(1) !important}</style></noscript>
