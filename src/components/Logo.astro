---
interface Props {
  className?: string;
  lang?: string;
}

const logoLabels: Record<string, string> = {
  es: "Julián Recarte - Inicio",
  en: "Julián Recarte - Home",
  it: "Julián Recarte - Home",
};

const { className = "", lang = "es" } = Astro.props;
const logoLabel = logoLabels[lang] || logoLabels.es;
---

<a
  href={`${import.meta.env.BASE_URL}${lang}/`}
  class={"inline-flex items-center justify-center text-copy dark:text-dark-copy leading-none no-underline transition-transform duration-300 hover:scale-110 hover:rotate-[25deg]" + (className ? " " + className : "")}
  aria-label={logoLabel}
>
  <img
    src="/logoOriginal.svg"
    alt="JR"
    class="h-12 w-auto dark:hidden"
    width="200"
    height="200"
  />
  <img
    src="/logoOriginalBlanco.svg"
    alt="JR"
    class="h-12 w-auto hidden dark:block"
    width="200"
    height="200"
  />
</a>
