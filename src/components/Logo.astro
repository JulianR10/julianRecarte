---
import logoJr from "@assets/images/logo-jr.svg?raw";

interface Props {
  className?: string;
  lang?: string;
}

const logoLabels: Record<string, string> = {
  es: "Julián Recarte - Inicio",
  en: "Julián Recarte - Home",
  it: "Julián Recarte - Home",
};

const { className = "", lang = "es" } = Astro.props;
const logoLabel = logoLabels[lang] || logoLabels.es;
---

<a
  href={`${import.meta.env.BASE_URL}${lang}/`}
  class={"inline-block text-copy dark:text-dark-copy leading-none no-underline transition-transform duration-300 hover:scale-110 hover:rotate-[25deg]" + (className ? " " + className : "")}
  aria-label={logoLabel}
>
  <span
    class="block h-11 md:h-12 w-auto [&>svg]:h-full [&>svg]:w-auto [&>svg]:block"
    set:html={logoJr}
  />
</a>
