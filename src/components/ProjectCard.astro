---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  lang: string;
  slug: string;
  title: string;
  description: string;
  style: string;
  accent: string;
  image?: ImageMetadata;
  liveUrl?: string;
  viewSite?: string;
  comingSoon?: string;
  caseLabel?: string;
  showCase?: boolean;
  className?: string;
}

const { lang, slug, title, description, style, accent, image, liveUrl, viewSite, comingSoon, caseLabel, showCase = true, className } = Astro.props;

const caseStudyHref = `/${lang}/proyectos/${slug}/`;

const wrapperAttrs: Record<string, any> = {
  "data-project-card": true,
  class: `${className || ""} group relative overflow-hidden isolate rounded-2xl bg-white/50 dark:bg-dark-card/50 border border-black/5 dark:border-dark-muted/20 md:hover:border-black/10 md:dark:hover:border-dark-muted/30 transition-shadow duration-500 md:transition-[box-shadow,border-color] duration-500 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:hover:shadow-xl md:hover:shadow-black/5`.trim(),
};
---

<article {...wrapperAttrs}>
  <div data-card-shine class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 z-[1]"></div>

  <div
    class="aspect-[4/3] relative overflow-hidden rounded-t-2xl"
    style={image ? undefined : "background: " + style}
  >
    {image ? (
      <Image src={image} alt={title} width={400} height={300} loading="lazy" decoding="async" class="w-full h-full object-contain p-8 rounded-t-2xl" style={`background: ${style}; filter: drop-shadow(0 6px 20px rgba(0,0,0,0.25))`} />
    ) : (
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHZpZXdCb3g9IjAgMCA0MCA0MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMCAwaDQwdjQwSDB6IiBmaWxsPSJub25lIi8+PHBhdGggZD0iTTAgMjBoNDBNMjAgMHY0MCIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utd2lkdGg9IjAuNSIgc3Ryb2tlLW9wYWNpdHk9IjAuMDYiLz48L3N2Zz4=')] opacity-50">
      </div>
    )}
    <div class="absolute top-4 left-4 flex gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-white/20 dark:bg-dark-muted/30"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/20 dark:bg-dark-muted/30"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-white/20 dark:bg-dark-muted/30"></span>
    </div>
    {comingSoon ? (
      <div class="absolute top-4 right-4">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium tracking-wider uppercase bg-accent-orange/90 text-white backdrop-blur-sm shadow-sm">
          {comingSoon}
        </span>
      </div>
    ) : null}
  </div>

  <div class="p-6 md:p-8">
    <h3 class="text-2xl font-medium mb-3 text-accent-orange transition-colors duration-300 md:group-hover:text-accent-purple">
      {title}
    </h3>
    <p class="text-copy/60 dark:text-dark-muted text-sm leading-relaxed mb-6">
      {description}
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      {liveUrl ? (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-accent-orange to-accent-pastel text-white font-medium text-xs md:text-sm tracking-wider uppercase shadow-md transition-transform duration-300 md:group-hover:scale-105"
        >
          {viewSite}
        </a>
      ) : null}
      {showCase ? (
      <a
        href={caseStudyHref}
        class="group/link inline-flex items-center gap-2 text-sm font-semibold tracking-wide uppercase cursor-pointer transition-opacity duration-300 hover:opacity-70"
        style={`color: ${accent}`}
        aria-label={`${caseLabel || "Case study"}: ${title}`}
      >
        {caseLabel}
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover/link:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
      ) : null}
    </div>
  </div>
</article>
