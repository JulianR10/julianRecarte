---
import ProjectCard from "./ProjectCard.astro";
import SectionHeader from "./SectionHeader.astro";
import { projects } from "@data/projects";

interface Props {
  lang: string;
  t: {
    label: string;
    title: string;
    highlight: string;
    comingSoon: string;
    viewSite: string;
    caseStudy: string;
    carouselLabel: string;
    gotoProject: string;
    items: {
      title: string;
      description: string;
    }[];
  };
}

const { lang, t } = Astro.props;
---

<section
  class="relative md:z-[2] min-h-screen px-6 py-16 md:py-24"
>
  <div id="proyectos" class="max-w-7xl mx-auto">
    <SectionHeader label={t.label} title={t.title} highlight={t.highlight} />

    <div
      data-reveal-stagger
      id="projects-track"
      role="region"
      aria-roledescription="carousel"
      aria-label={t.carouselLabel}
      tabindex="0"
      class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 scroll-pe-6 -mx-6 px-6 py-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden
             md:grid md:grid-cols-2 xl:grid-cols-3 md:overflow-visible md:snap-none md:gap-6 md:gap-8 md:-mx-0 md:px-0 md:py-0"
    >
      {projects.map((project, i) => {
        const item = t.items[i] || { title: project.title, description: "" };
        return (
          <ProjectCard
            lang={lang}
            slug={project.slug}
            title={item.title}
            description={item.description}
            image={project.image}
            style={project.style}
            accent={project.accent}
            liveUrl={project.liveUrl}
            viewSite={t.viewSite}
            comingSoon={project.comingSoon ? t.comingSoon : undefined}
            caseLabel={t.caseStudy}
            className="min-w-[85%] sm:min-w-[65%] snap-start sm:snap-center md:min-w-0 md:snap-none"
          />
        );
      })}
    </div>

    <div id="projects-dots" class="flex justify-center gap-2 mt-6 md:hidden">
      {projects.map((_, i) => (
        <button
          type="button"
          class="project-dot w-3 h-3 p-4 rounded-full transition-all duration-300 cursor-pointer border-none bg-clip-content bg-copy/20 dark:bg-dark-muted/20"
          data-index={i}
          aria-label={`${t.gotoProject} ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>
