---
import { Image } from "astro:assets";
import heroImg from "@assets/images/yo.webp";
import WhatsAppIcon from "@components/WhatsAppIcon.astro";
import Button from "@components/Button.astro";
import SectionFade from "@components/SectionFade.astro";
import { waLink } from "@data/contact";
import { HERO_WIDTHS, HERO_SIZES_MOBILE, HERO_SIZES_DESKTOP } from "@data/hero-image";

interface Props {
  t: {
    label: string;
    greetingPrefix: string;
    greetingName: string;
    subtitlePrefix: string;
    subtitleWords: string[];
    subtitleTail: string;
    subtitleLine2: string;
    cta: string;
    viewProjects: string;
    contact: string;
  };
  /** Mensaje precargado del WhatsApp: vive en `layout` porque lo comparte todo el sitio. */
  waMessage: string;
}

const { t, waMessage } = Astro.props;
---

<section
  id="hero"
  class="min-h-svh xl:h-dvh sticky top-0 z-[1] flex items-center px-6 pt-[var(--navbar-h)] md:py-24 overflow-hidden"
>
  <div data-hero-orb class="hidden md:block fixed top-1/4 -left-32 w-96 h-96 rounded-full orb-accent blur-3xl pointer-events-none"></div>
  <div data-hero-orb class="hidden md:block fixed -top-36 -right-20 w-72 h-72 rounded-full bg-accent-pastel/20 blur-3xl pointer-events-none dark:bg-accent-pastel/5 z-40"></div>

  <div class="max-w-7xl mx-auto w-full flex items-center justify-center xl:justify-between gap-12">
    <div data-hero-text class="max-w-3xl text-center xl:text-left">
      <span
        data-reveal
        class="t-eyebrow relative inline-block text-accent-ink mb-6 md:mb-8"
      >
        <span class="zap-text">{t.label}</span>
        <span data-zap-clone class="absolute inset-0 pointer-events-none zap-glow-brand" aria-hidden="true">{t.label}</span>
        <span data-zap-clone class="absolute inset-0 pointer-events-none zap-glow-orange" aria-hidden="true">{t.label}</span>
      </span>

      <div class="flex xl:hidden justify-center my-8">
        <div class="w-44 sm:w-56 max-w-[55vw] aspect-[2/3] rounded-[2rem] p-[2px] bg-gradient-to-br from-accent-warm to-accent-warm/5 dark:bg-gradient-to-tl dark:from-accent-warm dark:to-accent-warm/5 shadow-xl">
          <div class="w-full h-full rounded-[2rem] overflow-hidden">
            <Image
              src={heroImg}
              alt="Julián Recarte"
              width={1024}
              height={1536}
              widths={HERO_WIDTHS}
              sizes={HERO_SIZES_MOBILE}
              class="w-full h-full object-cover scale-[1.78] translate-y-[14%]"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <h1
        data-reveal-heading
        class="t-h1 font-medium mb-4 text-copy dark:text-dark-copy text-balance"
      >
        {t.greetingPrefix}<span class="text-accent-deep whitespace-nowrap">{t.greetingName}</span>
        <span class="sr-only"> — {t.label}</span>
      </h1>

      <p
        data-reveal
        class="t-lead mb-6 text-copy/70 dark:text-dark-muted"
      >
        <span class="block">
          {t.subtitlePrefix}{" "}
          <span
            data-rotator
            class="relative inline-block align-baseline text-accent-ink font-medium"
            aria-live="polite"
          >
            {(Array.isArray(t.subtitleWords) ? t.subtitleWords : []).map((word, i) => (
              <span
                data-rotator-word
                class:list={["whitespace-nowrap", i === 0 ? "relative inline-block" : "absolute left-0 top-0 opacity-0 invisible"]}
                aria-hidden={i !== 0 ? "true" : undefined}
              >
                <span class="rotator-base relative inline-block">{word}</span>
                <span data-rotator-zap aria-hidden="true" class="absolute inset-0 pointer-events-none zap-glow-brand">{word}</span>
                <span data-rotator-zap aria-hidden="true" class="absolute inset-0 pointer-events-none zap-glow-orange">{word}</span>
              </span>
            ))}
          </span>{" "}
          {t.subtitleTail}
        </span>
        <span class="block">{t.subtitleLine2}</span>
      </p>

      <p data-reveal class="t-lead italic text-accent-ink mt-6 mb-8 text-balance">
        {t.cta}
      </p>

      <div data-reveal class="flex flex-col sm:flex-row gap-3 justify-center xl:justify-start items-center">
        <Button href="#proyectos">{t.viewProjects}</Button>
        <Button href={waLink(waMessage)} variant="accent" external>
          <WhatsAppIcon />
          {t.contact}
        </Button>
      </div>

    </div>

    <div data-hero-image class="hidden xl:flex items-center justify-center w-full max-w-lg shrink-0">
      <div class="w-80 h-80 xl:w-[28rem] xl:h-[28rem] rounded-[2rem] p-[2px] bg-gradient-to-br from-accent-warm to-accent-warm/5 dark:bg-gradient-to-tl dark:from-accent-warm dark:to-accent-warm/5 shadow-xl">
        <div class="w-full h-full rounded-[2rem] overflow-hidden">
          <Image
            src={heroImg}
            alt="Julián Recarte"
            width={1024}
            height={1536}
            widths={HERO_WIDTHS}
            sizes={HERO_SIZES_DESKTOP}
            class="w-full h-full object-cover scale-[1.38] translate-y-[14%]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>

  </div>

  <SectionFade edge="bottom" />
</section>
