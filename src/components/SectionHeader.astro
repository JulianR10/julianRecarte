---
interface Props {
  label: string;
  title: string;
  highlight: string;
  id?: string;
  centered?: boolean;
  class?: string;
}

const { label, title, highlight, id, centered = true, class: className = "" } = Astro.props;
---

<div class:list={[{ "text-center": centered }, "mb-16 md:mb-20", className]} data-reveal>
  <span
    class="t-eyebrow inline-block text-accent-ink label-outline mb-6"
    data-reveal-heading
  >
    {label}
  </span>
  <h2
    id={id}
    data-reveal-heading
    class:list={["t-h2 font-medium max-w-3xl", { "mx-auto": centered }]}
  >
    {title} <span class="text-accent-deep whitespace-nowrap">{highlight}</span>
  </h2>
</div>