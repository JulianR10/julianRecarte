---
import { ViewTransitions } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  jobTitle?: string;
  lang?: string;
  t?: Record<string, string>;
}

const {
  title = "Julián Recarte | Desarrollador web FullStack",
  description = "Convierto ideas en experiencias web interactivas.",
  jobTitle = "Desarrollador web FullStack",
  lang = "es",
  t = { skipLink: "Ir al contenido principal", backToTop: "Volver arriba" },
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#E8E0D0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1A18" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="uCipOPVggRgVZ-5D8k06oVtNT1oeVXRMeu4rabjkL9o" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://julianrecarte.dev/${lang}/`} />
    <meta property="og:image" content="https://julianrecarte.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : lang === "en" ? "en_US" : "it_IT"} />
    <meta property="og:site_name" content="Julián Recarte" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://julianrecarte.dev/og-image.png" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href="https://julianrecarte.dev/es/" />
    <link rel="alternate" hreflang="en" href="https://julianrecarte.dev/en/" />
    <link rel="alternate" hreflang="it" href="https://julianrecarte.dev/it/" />
    <link rel="alternate" hreflang="x-default" href="https://julianrecarte.dev/" />
    <link rel="canonical" href={`https://julianrecarte.dev/${lang}/`} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Julián Recarte",
      "image": "https://julianrecarte.dev/og-image.png",
      "jobTitle": jobTitle,
      description,
      "url": `https://julianrecarte.dev/${lang}/`,
      "sameAs": [
        "https://github.com/JulianR10",
        "https://instagram.com/julianrecarte.dev",
        "https://wa.me/393447817557"
      ],
      "knowsAbout": [
        "Full Stack Development",
        "Frontend Development",
        "Backend Development",
        "React",
        "Astro",
        "GSAP",
        "TailwindCSS",
        "Three.js",
        "TypeScript",
        "Framer Motion"
      ],
      "knowsLanguage": ["Spanish", "English", "Italian"]
    })}></script>

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="preload"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      as="style"
      crossorigin
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mozilla+Headline:wdth,wght@75..125,100..900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("dark-mode");
        if (stored === "true") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <noscript><style>[data-reveal],[data-reveal-heading],[data-reveal-stagger]{opacity:1!important;transform:none!important}</style></noscript>
    <SpeedInsights />
  </head>
  <body transition:animate="slide">
    <a href="#main-content" class="skip-link">{t.skipLink}</a>
    <div data-hero-orb class="hidden md:block fixed top-1/4 -left-32 w-96 h-96 rounded-full orb-accent blur-3xl pointer-events-none"></div>
    <div data-hero-orb class="hidden md:block fixed -top-36 -right-20 w-72 h-72 rounded-full bg-accent-purple/10 blur-3xl pointer-events-none dark:bg-accent-purple/5 z-40"></div>
    <header><slot name="nav" /></header>
    <slot name="hero" />
    <main id="main-content" class="w-full max-w-[100vw] overflow-x-clip">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import { initAll, destroyAll } from "@scripts/main";
      import { createLifecycle } from "@scripts/lifecycle";
      createLifecycle(initAll, destroyAll);
    </script>



    <a
      id="btn-whatsapp"
      href="https://wa.me/393447817557"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-8 right-24 z-50 transition-all duration-300 cursor-pointer outline-none translate-y-20 opacity-0 pointer-events-none hover:scale-110 text-accent-orange"
      data-lenis-prevent
      aria-label="WhatsApp"
    >
      <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.07-.25-.13-1.06-.39-2.01-1.27-.74-.69-1.24-1.53-1.38-1.86-.14-.33-.01-.5.13-.67.14-.15.29-.33.42-.49.14-.17.19-.28.27-.47.08-.19.04-.36-.01-.5-.06-.13-.52-1.23-.71-1.78-.19-.55-.38-.48-.52-.46-.14.01-.3.02-.45.02-.16 0-.43.06-.66.31-.22.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.17 1.71 2.62 4.16 3.63.58.25 1.04.4 1.4.51.58.19 1.12.16 1.53.1.48-.07 1.43-.59 1.63-1.15.2-.56.2-1.05.14-1.15-.06-.1-.22-.16-.47-.28z"/>
      </svg>
    </a>

    <button
      id="btn-top"
      class="fixed bottom-8 right-8 z-50 p-3 rounded-full bg-accent-orange text-white shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer border-none outline-none translate-y-20 opacity-0 pointer-events-none"
      aria-label={t.backToTop}
      data-lenis-prevent
    >
      <svg
        id="arrow-top"
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M12 5L5 12M12 5L19 12" />
      </svg>
    </button>

  </body>
</html>
