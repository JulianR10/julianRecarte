---
import { ViewTransitions } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import WhatsAppIcon from "@components/WhatsAppIcon.astro";
import "@styles/globals.css";

interface Alternate {
  lang: string;
  href: string;
}

interface ArticleData {
  headline: string;
  description?: string;
  url?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
}

interface Props {
  title?: string;
  description?: string;
  jobTitle?: string;
  lang?: string;
  processSteps?: { title: string; description: string }[];
  canonical?: string;
  alternates?: Alternate[];
  article?: ArticleData;
  ogImage?: string;
  personBio?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  lock?: boolean;
  t?: {
    skipLink: string;
    backToTop: string;
  };
}

const {
  title = "Julián Recarte | Desarrollador web FullStack",
  description = "Convierto ideas en experiencias web interactivas.",
  jobTitle = "Desarrollador web FullStack",
  lang = "es",
  processSteps = [],
  canonical = `https://julianrecarte.dev/${lang}/`,
  alternates = [
    { lang: "es", href: "https://julianrecarte.dev/es/" },
    { lang: "en", href: "https://julianrecarte.dev/en/" },
    { lang: "it", href: "https://julianrecarte.dev/it/" },
  ],
  article,
  ogImage,
  personBio,
  schema = [],
  noindex = false,
  lock = false,
  t = { skipLink: "Ir al contenido principal", backToTop: "Volver arriba" },
} = Astro.props;

const SITE = "https://julianrecarte.dev";
const DEFAULT_LOCALE = "es";

// URL absoluta de la imagen Open Graph (default: portada del sitio).
const ogImageUrl = (ogImage || "/og-cover.jpg").startsWith("http")
  ? (ogImage as string)
  : `${SITE}${ogImage || "/og-cover.jpg"}`;

// x-default apunta a la versión del idioma por defecto (antes: home fijo).
const xDefault = alternates.find((a) => a.lang === DEFAULT_LOCALE)?.href ?? canonical;

// og:locale principal + alternativos.
const localeMap: Record<string, string> = { es: "es_ES", en: "en_US", it: "it_IT" };
const ogLocale = localeMap[lang] ?? "es_ES";
const ogLocaleAlternates = Object.entries(localeMap)
  .filter(([code]) => code !== lang)
  .map(([, value]) => value);

const personDescription = personBio || description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <ViewTransitions />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preloads / hints por página (p. ej. imagen LCP del hero). -->
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Julián Recarte" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#E8E0D0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1A18" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="uCipOPVggRgVZ-5D8k06oVtNT1oeVXRMeu4rabjkL9o" />
    <link rel="me" href="https://github.com/JulianR10" />
    <link rel="me" href="https://instagram.com/julianrecarte.dev" />
    <link rel="me" href="https://www.linkedin.com/in/julianrecarte/" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
    <meta property="og:site_name" content="Julián Recarte" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Hreflang -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="canonical" href={canonical} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": `${SITE}/#person`,
      "name": "Julián Recarte",
      "jobTitle": jobTitle,
      "description": personDescription,
      "url": `${SITE}/${lang}/`,
      "image": `${SITE}/og-cover.jpg`,
      "email": "julianrecarteweb@gmail.com",
      "sameAs": [
        "https://github.com/JulianR10",
        "https://instagram.com/julianrecarte.dev",
        "https://www.linkedin.com/in/julianrecarte/"
      ],
      "knowsAbout": [
        "Full Stack Development",
        "Frontend Development",
        "Backend Development",
        "React",
        "Astro",
        "GSAP",
        "TailwindCSS",
        "Supabase",
        "Three.js",
        "TypeScript"
      ],
      "knowsLanguage": [
        { "@type": "Language", "name": "Spanish", "alternateName": "es" },
        { "@type": "Language", "name": "English", "alternateName": "en" },
        { "@type": "Language", "name": "Italian", "alternateName": "it" }
      ]
    })}></script>

    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${article.url || canonical}#article`,
        "mainEntityOfPage": { "@type": "WebPage", "@id": article.url || canonical },
        "headline": article.headline,
        "description": article.description,
        "url": article.url || canonical,
        "image": article.image,
        "inLanguage": lang,
        "author": { "@id": `${SITE}/#person` },
        "publisher": {
          "@type": "Organization",
          "name": "Julián Recarte",
          "url": `${SITE}/${lang}/`,
          "logo": {
            "@type": "ImageObject",
            "url": `${SITE}/og-cover.jpg`,
            "width": 1200,
            "height": 630,
          },
        },
        ...(article.datePublished ? { "datePublished": article.datePublished } : {}),
        ...(article.dateModified
          ? { "dateModified": article.dateModified }
          : article.datePublished
            ? { "dateModified": article.datePublished }
            : {}),
      })}></script>
    )}

    {processSteps.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": `Cómo trabajo — ${jobTitle}`,
        "description": personDescription,
        "step": processSteps.map((step, i) => ({
          "@type": "HowToStep",
          "position": i + 1,
          "name": step.title,
          "text": step.description,
        })),
      })}></script>
    )}

    {schema.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="preload"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      as="style"
      crossorigin
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mozilla+Headline:wdth,wght@75..125,100..900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("dark-mode");
        if (stored === "true") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <noscript><style>[data-reveal],[data-reveal-heading],[data-reveal-stagger]{opacity:1!important;transform:none!important}</style></noscript>
    <SpeedInsights />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R1ZPHT8LX2"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R1ZPHT8LX2');
    </script>
  </head>
  <body transition:animate="slide" class={lock ? "is-locked" : undefined}>
    <a href="#main-content" class="skip-link">{t.skipLink}</a>
    <header><slot name="nav" /></header>
    <slot name="hero" />
    <main id="main-content" class="w-full max-w-[100vw] overflow-x-clip">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import { initAll, destroyAll } from "@scripts/main";
      import { createLifecycle } from "@scripts/lifecycle";
      createLifecycle(initAll, destroyAll);
    </script>



    <a
      id="btn-whatsapp"
      href="https://wa.me/393447817557"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-8 right-24 z-30 flex items-center justify-center w-12 h-12 rounded-full bg-[var(--bg-hex)]/80 dark:bg-dark-card/90 backdrop-blur-lg shadow-lg transition-all duration-300 cursor-pointer outline-none translate-y-20 opacity-0 pointer-events-none hover:scale-110 text-accent-orange"
      data-lenis-prevent
      aria-label="WhatsApp"
    >
      <WhatsAppIcon class="w-7 h-7" />
    </a>

    <button
      id="btn-top"
      class="fixed bottom-8 right-8 z-30 flex items-center justify-center w-12 h-12 rounded-full bg-[var(--bg-hex)]/80 dark:bg-dark-card/90 backdrop-blur-lg shadow-lg transition-all duration-300 cursor-pointer border-none outline-none translate-y-20 opacity-0 pointer-events-none hover:scale-110 text-accent-orange"
      aria-label={t.backToTop}
      data-lenis-prevent
    >
      <svg
        id="arrow-top"
        class="w-7 h-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M12 5L5 12M12 5L19 12" />
      </svg>
    </button>

  </body>
</html>
