<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Julián Recarte, desarrollador web FullStack. Diseño y construyo landing pages, catálogos y ecommerce a medida con Astro, Tailwind y Supabase." />
  <meta name="robots" content="noindex" />
  <title>Julián Recarte | Desarrollador web FullStack</title>
  <script>
    (function() {
      var langs = ["es", "en", "it"];
      var nav = (navigator.language || navigator.userLanguage || "es").slice(0, 2);
      var lang = langs.indexOf(nav) !== -1 ? nav : "es";
      var base = window.location.pathname.replace(/\/+$/g, "");
      window.location.replace(base + "/" + lang + "/");
    })();
  </script>
</head>
<body style="background-color: #E8E0D0; margin: 0">
  <p hidden>Redirecting to <a href="/es/">Julián Recarte</a>...</p>
</body>
</html>