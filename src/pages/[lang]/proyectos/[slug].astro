---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import CaseStudy from "@components/CaseStudy.astro";
import Footer from "@components/Footer.astro";
import { projects } from "@data/projects";
import { getProjectCopy } from "@data/project-content";
import { breadcrumbSchema } from "@data/schema";

import es from "@i18n/es.json";
import en from "@i18n/en.json";
import it from "@i18n/it.json";
import { safeT } from "@i18n/safe-t";

const langs = ["es", "en", "it"] as const;
const translations = { es, en, it };

export function getStaticPaths() {
  const paths = ["es", "en", "it"] as const;
  return paths.flatMap((lang) =>
    projects
      .filter((project) => !project.comingSoon)
      .map((project) => ({ params: { lang, slug: project.slug } }))
  );
}

const { lang, slug } = Astro.params as { lang: string; slug: string };
const raw = translations[lang as keyof typeof translations];
if (!raw) return Astro.redirect("/es/");

const project = projects.find((p) => p.slug === slug);
if (!project) return Astro.redirect(`/${lang}/`);

const t = safeT(raw);

const { backLabel } = t.caseStudies;
const cs = {
  backLabel,
  ...getProjectCopy(project.slug, lang),
};

const canonical = `https://julianrecarte.dev/${lang}/proyectos/${project.slug}/`;
const alternates = langs.map((l) => ({
  lang: l,
  href: `https://julianrecarte.dev/${l}/proyectos/${project.slug}/`,
}));

const pageTitle = `${cs.title || project.title} | Julián Recarte`;
const pageDescription = cs.subtitle || "";

const SITE = "https://julianrecarte.dev";
const projectOg: Record<string, string> = {
  triba: "/og-triba.jpg",
  multiservizi: "/og-multiservizi.jpg",
};
const ogImage = projectOg[project.slug] ?? "/og-cover.jpg";
// Última modificación: fecha del build (sitio estático → coincide con el deploy).
const buildDate = new Date().toISOString().slice(0, 10);
const articleImage = project.screenshots[0]?.src ?? project.mockup?.src;
const articleImageAbs = articleImage
  ? articleImage.startsWith("http")
    ? articleImage
    : `${SITE}${articleImage}`
  : `${SITE}${ogImage}`;

const schema = [
  breadcrumbSchema({
    lang,
    homeLabel: t.layout.home,
    name: cs.title || project.title,
    path: `/${lang}/proyectos/${project.slug}/`,
  }),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  ogImage={ogImage}
  personBio={t.layout.bio}
  schema={schema}
  article={{
    headline: `${cs.title || project.title} — case study`,
    description: pageDescription,
    url: canonical,
    image: articleImageAbs,
    datePublished: project.publishedAt,
    dateModified: buildDate,
  }}
  t={t.layout}
  lock
>
  <Nav slot="nav" lang={lang} t={t.nav} prefix={`/${lang}/`} fixed={false} />
  <CaseStudy lang={lang} project={project} t={cs} />
  <Footer slot="footer" lang={lang} t={t.footer} />
</Layout>
