---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import Contact from "@components/Contact.astro";
import SectionHeader from "@components/SectionHeader.astro";

import es from "@i18n/es.json";
import en from "@i18n/en.json";
import it from "@i18n/it.json";
import { safeT } from "@i18n/safe-t";

import {
  websiteSchema,
  professionalServiceSchema,
  aboutPageSchema,
  faqSchema,
  breadcrumbSchema,
} from "@data/schema";

export function getStaticPaths() {
  return ["es", "en", "it"].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const translations = { es, en, it };
const raw = translations[lang as keyof typeof translations];
if (!raw) return Astro.redirect("/es/");

const t = safeT(raw);
const about = t.about;

const canonical = `https://julianrecarte.dev/${lang}/sobre/`;
const alternates = ["es", "en", "it"].map((l) => ({
  lang: l,
  href: `https://julianrecarte.dev/${l}/sobre/`,
}));

const pageTitle = `${about.title} ${about.highlight} | ${t.layout.jobTitle}`;
const pageDescription = about.metaDescription;

const schema = [
  websiteSchema(lang),
  aboutPageSchema({
    lang,
    name: pageTitle,
    description: pageDescription,
    path: `/${lang}/sobre/`,
  }),
  professionalServiceSchema({
    lang,
    jobTitle: t.layout.jobTitle,
    bio: t.layout.bio,
    services: t.soluciones.items,
  }),
  breadcrumbSchema({
    lang,
    homeLabel: t.layout.home,
    name: `${about.title} ${about.highlight}`,
    path: `/${lang}/sobre/`,
  }),
  faqSchema(about.faq),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jobTitle={t.layout.jobTitle}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  ogImage="/og-cover.jpg"
  personBio={t.layout.bio}
  schema={schema}
  t={t.layout}
>
  <Nav slot="nav" lang={lang} t={t.nav} prefix={`/${lang}/`} />

  <!-- Hero / intro -->
  <section class="relative px-6 pt-32 md:pt-40 pb-16 md:pb-20">
    <div class="max-w-5xl mx-auto" data-reveal>
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 text-sm font-medium tracking-wide uppercase text-copy/50 dark:text-dark-muted hover:text-accent-orange transition-colors duration-300 mb-8"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {about.backHome}
      </a>

      <span class="inline-block text-sm font-medium tracking-[0.3em] uppercase text-accent-orange mb-5">
        {about.label}
      </span>
      <h1 data-reveal-heading class="text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight tracking-tight mb-6 text-balance">
        {about.title} <span class="text-accent-orange whitespace-nowrap">{about.highlight}</span>
      </h1>
      <p class="text-lg md:text-xl text-copy/70 dark:text-dark-copy/70 leading-relaxed max-w-3xl">
        {about.intro}
      </p>
    </div>
  </section>

  <!-- En resumen -->
  <section class="relative px-6 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold mb-10 md:mb-12" data-reveal-heading>
        {about.factsTitle}
      </h2>
      <dl class="divide-y divide-black/5 dark:divide-dark-muted/20 border-t border-b border-black/5 dark:border-dark-muted/20">
        {about.facts.map((fact) => (
          <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-1 md:gap-8 py-5" data-reveal>
            <dt class="text-sm font-semibold tracking-wider uppercase text-copy/50 dark:text-dark-muted">{fact.label}</dt>
            <dd class="text-base md:text-lg text-copy dark:text-dark-copy">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Servicios -->
  <section class="relative px-6 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold mb-10 md:mb-12" data-reveal-heading>
        {about.servicesTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {t.soluciones.items.map((item, i) => (
          <div class="flex flex-col" data-reveal>
            <span aria-hidden="true" class="text-xs font-medium tracking-[0.22em] text-copy/30 dark:text-dark-muted/40 tabular-nums mb-3">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="text-2xl font-bold leading-tight tracking-tight bg-gradient-to-r from-accent-orange to-accent-warm bg-clip-text text-transparent mb-3">
              {item.title}
            </h3>
            <p class="text-sm md:text-base leading-relaxed text-copy/60 dark:text-dark-muted">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="relative px-6 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold mb-10 md:mb-12" data-reveal-heading>
        {about.processTitle}
      </h2>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
        {t.process.steps.map((step, i) => (
          <li class="flex gap-4" data-reveal>
            <span aria-hidden="true" class="shrink-0 w-9 h-9 rounded-full flex items-center justify-center text-sm font-semibold text-white bg-gradient-to-br from-accent-orange to-accent-pastel">
              {i + 1}
            </span>
            <div>
              <h3 class="text-lg font-bold text-copy dark:text-dark-copy mb-1">{step.title}</h3>
              <p class="text-sm md:text-base leading-relaxed text-copy/60 dark:text-dark-muted">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative px-6 py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <SectionHeader label={about.faqLabel} title={about.faqTitle} highlight={about.faqHighlight} />
      <div class="divide-y divide-black/5 dark:divide-dark-muted/20 border-t border-b border-black/5 dark:border-dark-muted/20">
        {about.faq.map((item) => (
          <details class="group py-5" data-reveal>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-base md:text-lg font-medium text-copy dark:text-dark-copy hover:text-accent-orange transition-colors duration-300">
              {item.q}
              <svg class="w-5 h-5 shrink-0 text-accent-orange transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-4 text-sm md:text-base leading-relaxed text-copy/60 dark:text-dark-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Contact t={t.contact} />

  <Footer slot="footer" lang={lang} t={t.footer} />
</Layout>
