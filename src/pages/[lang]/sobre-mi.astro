---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import SectionHeader from "@components/SectionHeader.astro";
import WhatsAppIcon from "@components/WhatsAppIcon.astro";
import Button from "@components/Button.astro";
import { waLink, mailtoLink } from "@data/contact";

import es from "@i18n/es.json";
import en from "@i18n/en.json";
import it from "@i18n/it.json";
import { safeT } from "@i18n/safe-t";

import {
  websiteSchema,
  professionalServiceSchema,
  aboutPageSchema,
  faqSchema,
  breadcrumbSchema,
} from "@data/schema";

export function getStaticPaths() {
  return ["es", "en", "it"].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const translations = { es, en, it };
const raw = translations[lang as keyof typeof translations];
if (!raw) return Astro.redirect("/es/");

const t = safeT(raw);
const about = t.about;
const waHref = waLink(t.layout.whatsappMessage);

const canonical = `https://julianrecarte.dev/${lang}/sobre-mi/`;
const alternates = ["es", "en", "it"].map((l) => ({
  lang: l,
  href: `https://julianrecarte.dev/${l}/sobre-mi/`,
}));

// El H1 ya no lleva el nombre ("Sobre mí"): el <title> lo recupera para SEO.
const pageTitle = `${about.title} ${about.highlight} | Julián Recarte, ${t.layout.jobTitle}`;
const pageDescription = about.metaDescription;

// Bento de "En resumen": el 1º y el 4º ocupan dos columnas (2 + 1 / 1 + 2).
const factSpan = ["md:col-span-2", "", "", "md:col-span-2"];
// Chips de la tarjeta "Idiomas": mismo orden en los 3 JSON (es · en · it).
const langChips = ["es", "en", "it"];

const schema = [
  websiteSchema(lang),
  aboutPageSchema({
    lang,
    name: pageTitle,
    description: pageDescription,
    path: `/${lang}/sobre-mi/`,
  }),
  professionalServiceSchema({
    lang,
    jobTitle: t.layout.jobTitle,
    bio: t.layout.bio,
    services: t.soluciones.items,
  }),
  breadcrumbSchema({
    lang,
    homeLabel: t.layout.home,
    name: `${about.title} ${about.highlight}`,
    path: `/${lang}/sobre-mi/`,
  }),
  faqSchema(about.faq),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jobTitle={t.layout.jobTitle}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  ogImage="/og-cover.jpg"
  personBio={t.layout.bio}
  schema={schema}
  t={t.layout}
>
  <Nav slot="nav" lang={lang} t={t.nav} prefix={`/${lang}/`} />

  <!-- Hero: bio (sin retrato por ahora). `isolate` + wash en -z-10 para que el wash no le pinte encima. -->
  <section
    data-about-hero
    class="relative isolate px-6 pt-[calc(var(--navbar-h)+3rem)] pb-16 md:pt-[calc(var(--navbar-h)+5rem)] md:pb-24 lg:pt-[var(--navbar-h)] lg:min-h-[min(100svh,860px)] lg:flex lg:items-center overflow-clip"
  >
    <div data-about-wash aria-hidden="true" class="about-wash pointer-events-none absolute inset-x-0 top-0 -bottom-8 -z-10"></div>

    <div class="w-full max-w-7xl mx-auto">
      <!-- Texto (mobile: todo centrado). El rol ("Desarrollador web FullStack") queda para lectores. -->
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto lg:py-16">
        <p class="sr-only">{about.label}</p>

        <h1 data-reveal-heading class="t-h1 font-medium text-copy dark:text-dark-copy text-balance mb-6">
          {about.title} <span class="text-accent-deep whitespace-nowrap">{about.highlight}</span>
        </h1>

        <p class="t-lead text-copy dark:text-dark-copy max-w-xl text-balance mb-4">
          {about.introLead}
        </p>

        <p class="t-body-lg text-copy/70 dark:text-dark-muted max-w-xl mb-10">
          {about.intro}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 items-center">
          <Button href={waHref} external>
            <WhatsAppIcon />
            {about.ctaPrimary}
          </Button>
          <Button href={`/${lang}/#proyectos`} variant="accent">{about.ctaSecondary}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack: banda editorial animada (decorativa; la lista accesible va en sr-only).
       Velocidad e inclinación reaccionan al scroll (about-intro.ts). -->
  <div
    data-reveal
    class="about-stack relative border-y line-hair py-4 md:py-5 overflow-hidden"
  >
    <div data-about-stack class="about-stack-track flex w-max" aria-hidden="true">
      {[0, 1].map(() => (
        <ul class="flex items-center">
          {[...about.stack, ...about.stack].map((item) => (
            <li class="about-stack-item flex items-center gap-6 px-3 whitespace-nowrap t-eyebrow text-copy/70 dark:text-dark-muted">
              {item}
              <span class="w-1 h-1 rounded-full bg-accent-orange"></span>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <ul class="sr-only">
      {about.stack.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <!-- En resumen: bento -->
  <section class="relative px-6 py-16 md:py-24">
    <div class="max-w-7xl mx-auto">
      <SectionHeader title={about.factsTitle} highlight={about.factsHighlight} />

      <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5" data-reveal-stagger>
        {about.facts.map((fact, i) => (
          <div
            class:list={[
              "about-card group relative flex flex-col gap-6 rounded-lg border line-hair bg-white/50 dark:bg-dark-card/50 shadow-card md:hover:shadow-card-hover md:hover:border-accent-orange/25 transition-[box-shadow,border-color] duration-500 p-5 md:p-6",
              factSpan[i],
            ]}
          >
            {fact.icon === "globe" && (
              <!-- Bandera que entra desde la derecha y queda pegada al borde derecho de la tarjeta, con el chip activo. -->
              <span aria-hidden="true" class="about-flags">
                {langChips.map((l) => (
                  <span class="about-flag" data-flag={l}>
                    <span class="about-flag-cloth"></span>
                  </span>
                ))}
              </span>
            )}
            <!-- Cabecera fija en todas las tarjetas: label a la izquierda, ícono a la derecha. -->
            <div class="about-head flex items-center justify-between gap-4">
              <dt class="t-badge text-copy/70 dark:text-dark-muted">{fact.label}</dt>
              <span
                aria-hidden="true"
                class:list={[
                  "flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-accent-orange/10 text-accent-orange transition-transform duration-500 group-hover:rotate-[8deg] group-hover:scale-110",
                  { "about-globe": fact.icon === "globe" },
                ]}
              >
                <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {fact.icon === "layers" ? (
                    <path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                  ) : fact.icon === "globe" ? (
                    <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  ) : fact.icon === "remote" ? (
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                  ) : (
                    <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
                  )}
                </svg>
              </span>
            </div>

            <!-- Contenido anclado abajo: con o sin contador, todas cierran a la misma línea. -->
            <dd class="mt-auto flex flex-col gap-3">
              {fact.stat && (
                <span class="t-h2 leading-none font-medium text-accent-deep tabular-nums">
                  <span data-count-to={fact.stat}>{fact.stat}</span>{fact.suffix}
                </span>
              )}
              {fact.value.includes("·") ? (
                <span class="flex flex-wrap gap-2">
                  {fact.value.split("·").map((chip, j) => (
                    <span
                      class="t-badge rounded-full border line-hair px-3 py-1.5 text-copy/80 dark:text-dark-copy"
                      data-lang-chip={fact.icon === "globe" ? langChips[j] : undefined}
                      tabindex={fact.icon === "globe" ? -1 : undefined}
                    >
                      {chip.trim()}
                    </span>
                  ))}
                </span>
              ) : (
                <span class:list={[
                  "text-balance",
                  fact.stat ? "t-body text-copy/70 dark:text-dark-muted" : "t-h4 font-medium text-copy dark:text-dark-copy",
                ]}>
                  {fact.value}
                </span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Cómo trabajo: lista editorial (mismo lenguaje que Soluciones del home),
       en banda invertida para cortar la seguidilla de secciones beige. -->
  <section class="about-band surface-ink relative px-6 py-16 md:py-24">
    <div class="max-w-7xl mx-auto">
      <SectionHeader title={about.principlesTitle} highlight={about.principlesHighlight} />

      <div>
        {about.principles.map((item, i) => (
          <div class="group relative grid grid-cols-1 md:grid-cols-[300px_1fr] gap-3 md:gap-12 py-8 md:py-10">
            <div data-solu-line aria-hidden="true" class="absolute top-0 left-0 right-0 h-px bg-white/[0.1] origin-left"></div>
            {i === about.principles.length - 1 && (
              <div data-solu-line aria-hidden="true" class="absolute bottom-0 left-0 right-0 h-px bg-white/[0.1] origin-left"></div>
            )}
            <div class="flex flex-row items-baseline gap-3">
              <span aria-hidden="true" class="t-index text-dark-muted/40 shrink-0">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <h3 class="t-h3 font-bold text-accent-deep">
                {item.title}
              </h3>
            </div>
            <p class="t-body text-dark-muted text-balance">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative px-6 py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <SectionHeader title={about.faqTitle} highlight={about.faqHighlight} />

      <div class="about-faq border-t line-hair">
        {about.faq.map((item, i) => (
          <details class="group border-b line-hair">
            <summary class="flex items-start gap-4 md:gap-6 cursor-pointer list-none py-6 t-body-lg font-medium text-copy dark:text-dark-copy hover:text-accent-ink transition-colors duration-300">
              <span aria-hidden="true" class="t-index shrink-0 pt-1 text-copy/30 dark:text-dark-muted/40 group-open:text-accent-ink transition-colors duration-300">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="flex-1">{item.q}</span>
              <span aria-hidden="true" class="flex items-center justify-center w-8 h-8 -mt-0.5 shrink-0 rounded-full border border-accent-orange/30 text-accent-orange transition-[transform,background-color,color] duration-300 group-open:rotate-45 group-open:bg-accent-orange group-open:text-white">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="about-faq-answer t-body pb-7 pl-10 md:pl-14 pr-4 text-copy/70 dark:text-dark-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre: CTA de contacto (sin id="contacto": el nav marca "Sobre mí" por ruta) -->
  <section class="relative px-6 py-20 md:py-28 overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 w-[600px] h-[600px] max-w-[150vw] rounded-full bg-accent-orange/[0.03] blur-3xl pointer-events-none dark:opacity-0"
    ></div>

    <div class="relative max-w-3xl mx-auto flex flex-col items-center text-center">
      <SectionHeader title={about.closingTitle} highlight={about.closingHighlight} class="!mb-8" centered={true} />

      <p class="t-lead text-copy/70 dark:text-dark-muted max-w-xl mb-10 text-balance">
        {about.closingText}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 items-center">
        <Button href={waHref} external>
          <WhatsAppIcon />
          {about.closingWhatsapp}
        </Button>
        <Button href={mailtoLink(t.contact.emailSubject)} variant="outline">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M22 6L12 13 2 6M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" />
          </svg>
          {about.closingEmail}
        </Button>
      </div>

      <a
        href={`/${lang}/`}
        data-reveal
        class="inline-flex items-center gap-2 mt-12 py-3 t-link-quiet font-medium text-copy/70 dark:text-dark-muted hover:text-accent-ink transition-colors duration-300"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {about.backHome}
      </a>
    </div>
  </section>

  <Footer slot="footer" lang={lang} t={t.footer} />
</Layout>

<style>
  /* Wash del hero: dos focos suaves de la paleta que dan profundidad al hero. */
  .about-wash {
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--clr-accent-orange) 14%, transparent), transparent 58%),
      radial-gradient(circle at 10% 72%, color-mix(in srgb, var(--clr-accent-pastel) 18%, transparent), transparent 52%);
  }

  :global(.dark) .about-wash {
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--clr-accent-orange) 10%, transparent), transparent 58%),
      radial-gradient(circle at 10% 72%, color-mix(in srgb, var(--clr-accent-pastel) 8%, transparent), transparent 52%);
  }

  /* Banda del stack: ticker continuo con bordes desvanecidos. */
  .about-stack {
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .about-stack-track {
    animation: about-marquee 32s linear infinite;
  }

  .about-stack-item {
    transition: color var(--dur-base) ease;
  }

  @media (hover: hover) {
    .about-stack:hover .about-stack-track {
      animation-play-state: paused;
    }

    .about-stack-item:hover {
      color: var(--clr-accent-ink);
    }
  }

  @keyframes about-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Banda invertida ("Cómo trabajo"): el H2 del SectionHeader hereda el color. */
  .about-band {
    background-color: theme("colors.copy");
    color: theme("colors.dark.copy");
  }

  :global(.dark) .about-band {
    background-color: theme("colors.dark.card");
  }

  /* Tarjeta "Idiomas": al pasar el mouse (o, en táctil, tocar) por un
     idioma, su bandera entra desde el borde derecho de la tarjeta y queda
     pegada a él: 40% del ancho, todo el alto, difuminada hacia la izquierda y
     de baja opacidad (decorativa). Una sola tela: la onda es un balanceo
     suave más bandas de luz y sombra que viajan hacia el lado libre (solo
     transform/opacity). Hex de bandera, no de marca. */
  .about-flags {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  .about-flag {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(100%);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
  }
  /* Un poco más alta que la tarjeta: el balanceo no deja huecos arriba ni abajo. */
  .about-flag-cloth {
    position: absolute;
    right: 0;
    top: -8px;
    bottom: -8px;
    width: 40%;
    overflow: hidden;
    background: var(--flag-art) 0 0 / 100% 100% no-repeat;
    opacity: 0.5;
    transform-origin: 100% 50%;
    -webkit-mask-image: linear-gradient(to left, #000 20%, transparent 100%);
    mask-image: linear-gradient(to left, #000 20%, transparent 100%);
    animation: about-flag-sway 2.6s ease-in-out infinite alternate;
    animation-play-state: var(--run, paused);
  }
  /* Luz y sombra: patrón sin cortes (empieza y termina igual), 72px de período. */
  .about-flag-cloth::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% + 72px);
    background: linear-gradient(90deg, rgb(0 0 0 / 0.22), rgb(255 255 255 / 0.2), rgb(0 0 0 / 0.22)) 0 0 / 72px 100% repeat-x;
    animation: about-flag-ripple 1.8s linear infinite;
    animation-play-state: var(--run, paused);
  }
  .about-flag[data-flag="es"] { --flag-art: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 9 6' preserveAspectRatio='none'><path fill='%2374ACDF' d='M0 0h9v6H0z'/><path fill='%23fff' d='M0 2h9v2H0z'/><circle cx='4.5' cy='3' r='.6' fill='%23F6B40E' stroke='%2385340A' stroke-width='.1'/></svg>"); }
  .about-flag[data-flag="en"] { --flag-art: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 30' preserveAspectRatio='none'><clipPath id='t'><path d='M30 15h30v15zv15H0zH0V0zV0h30z'/></clipPath><path fill='%23012169' d='M0 0h60v30H0z'/><path stroke='%23fff' stroke-width='6' d='M0 0l60 30m0-30L0 30'/><path stroke='%23C8102E' stroke-width='4' clip-path='url(%23t)' d='M0 0l60 30m0-30L0 30'/><path stroke='%23fff' stroke-width='10' d='M30 0v30M0 15h60'/><path stroke='%23C8102E' stroke-width='6' d='M30 0v30M0 15h60'/></svg>"); }
  .about-flag[data-flag="it"] { --flag-art: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2' preserveAspectRatio='none'><path fill='%23009246' d='M0 0h1v2H0z'/><path fill='%23fff' d='M1 0h1v2H1z'/><path fill='%23CE2B37' d='M2 0h1v2H2z'/></svg>"); }

  .about-card:has([data-lang-chip="es"]:hover) .about-flag[data-flag="es"],
  .about-card:has([data-lang-chip="en"]:hover) .about-flag[data-flag="en"],
  .about-card:has([data-lang-chip="it"]:hover) .about-flag[data-flag="it"] {
    --run: running;
    opacity: 1;
    transform: translateX(0);
  }
  @keyframes about-flag-sway {
    from { transform: skewY(-1.5deg) scaleX(1); }
    to { transform: skewY(1.5deg) scaleX(0.97); }
  }
  @keyframes about-flag-ripple {
    to { transform: translateX(-72px); }
  }

  /* El globo reacciona. */
  /* El globo se corre a la izquierda para quedar fuera de la bandera (40% del
     ancho de la cabecera, justo donde la bandera termina) y rueda una vuelta
     completa: termina derecho, no como un "prohibido". */
  .about-head {
    container-type: inline-size;
  }
  .about-card:has([data-lang-chip]:hover) .about-globe {
    transform: translateX(calc(-40cqw + 4px)) rotate(-360deg) scale(1.1);
  }
  [data-lang-chip] {
    cursor: default;
    transition: border-color var(--dur-base) ease, color var(--dur-base) ease;
  }
  [data-lang-chip]:hover {
    border-color: currentColor;
  }
  [data-lang-chip]:focus:not(:focus-visible) {
    outline: none;
  }
  /* Solo hover en desktop: el chip no se selecciona ni queda "pegado" al hacer
     clic (tabindex -1: sin parada de Tab). En táctil no hay hover fiable, así
     que el toque (foco) muestra la bandera. */
  [data-lang-chip] {
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: none) {
    .about-card:has([data-lang-chip="es"]:focus) .about-flag[data-flag="es"],
    .about-card:has([data-lang-chip="en"]:focus) .about-flag[data-flag="en"],
    .about-card:has([data-lang-chip="it"]:focus) .about-flag[data-flag="it"] {
      --run: running;
      opacity: 1;
      transform: translateX(0);
    }
    .about-card:has([data-lang-chip]:focus) .about-globe {
      transform: translateX(calc(-40cqw + 4px)) rotate(-360deg) scale(1.1);
    }
    [data-lang-chip]:focus {
      border-color: currentColor;
    }
  }

  /* FAQ: altura animada con ::details-content (mejora progresiva: sin
     soporte abre en seco, como antes). */
  .about-faq details {
    interpolate-size: allow-keywords;
  }

  .about-faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.45s allow-discrete;
  }

  .about-faq details[open]::details-content {
    block-size: auto;
  }

  .about-faq-answer {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.4s ease 0.05s,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
  }

  .about-faq details[open] .about-faq-answer {
    opacity: 1;
    transform: none;
  }
</style>
