---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import SectionHeader from "@components/SectionHeader.astro";
import WhatsAppIcon from "@components/WhatsAppIcon.astro";
import Button from "@components/Button.astro";
import { Image, getImage } from "astro:assets";
import { waLink, mailtoLink } from "@data/contact";

import retrato from "@assets/images/sobreMi.webp";

import es from "@i18n/es.json";
import en from "@i18n/en.json";
import it from "@i18n/it.json";
import { safeT } from "@i18n/safe-t";

import {
  websiteSchema,
  professionalServiceSchema,
  aboutPageSchema,
  faqSchema,
  breadcrumbSchema,
} from "@data/schema";

export function getStaticPaths() {
  return ["es", "en", "it"].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const translations = { es, en, it };
const raw = translations[lang as keyof typeof translations];
if (!raw) return Astro.redirect("/es/");

const t = safeT(raw);
const about = t.about;
const waHref = waLink(t.layout.whatsappMessage);

const canonical = `https://julianrecarte.dev/${lang}/sobre-mi/`;
const alternates = ["es", "en", "it"].map((l) => ({
  lang: l,
  href: `https://julianrecarte.dev/${l}/sobre-mi/`,
}));

// El H1 ya no lleva el nombre ("Sobre mí"): el <title> lo recupera para SEO.
const pageTitle = `${about.title} ${about.highlight} | Julián Recarte, ${t.layout.jobTitle}`;
const pageDescription = about.metaDescription;

// Mismo transform que la <Image> del retrato: la URL preloadeada
// es exactamente la que el navegador va a pedir (LCP del hero).
const retratoPreload = await getImage({ src: retrato, width: 1024 });

// Arco del rol: una sola vez, por fuera del disco, en su cuarto superior izquierdo.
// Unidades del viewBox (disco = radio 50); ángulos en grados, sentido matemático (0° = derecha, 90° = arriba).
// Va de un poco debajo de la mitad izquierda (206°) hasta pasar apenas el punto más alto (82°), en sentido horario.
const arcR = 53;
const arcFrom = 206;
const arcTo = 82;
const arcPoint = (deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return `${(50 + arcR * Math.cos(rad)).toFixed(2)} ${(50 - arcR * Math.sin(rad)).toFixed(2)}`;
};
const arcPath = `M ${arcPoint(arcFrom)} A ${arcR} ${arcR} 0 0 1 ${arcPoint(arcTo)}`;
const arcLength = (arcR * (arcFrom - arcTo) * Math.PI) / 180;

// Bento de "En resumen": el 1º y el 4º ocupan dos columnas (2 + 1 / 1 + 2).
const factSpan = ["md:col-span-2", "", "", "md:col-span-2"];
// Tinte de cada tarjeta: variaciones muy leves entre beige y naranja,
// alternadas para que dos vecinas nunca repitan tono.
const factTint = [
  "bg-white/40 dark:bg-dark-card",
  "bg-accent-orange/[0.06] dark:bg-accent-orange/[0.07]",
  "bg-accent-pastel/[0.14] dark:bg-accent-pastel/[0.05]",
  "bg-accent-warm/[0.04] dark:bg-dark-card",
];

const schema = [
  websiteSchema(lang),
  aboutPageSchema({
    lang,
    name: pageTitle,
    description: pageDescription,
    path: `/${lang}/sobre-mi/`,
  }),
  professionalServiceSchema({
    lang,
    jobTitle: t.layout.jobTitle,
    bio: t.layout.bio,
    services: t.soluciones.items,
  }),
  breadcrumbSchema({
    lang,
    homeLabel: t.layout.home,
    name: `${about.title} ${about.highlight}`,
    path: `/${lang}/sobre-mi/`,
  }),
  faqSchema(about.faq),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jobTitle={t.layout.jobTitle}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  ogImage="/og-cover.jpg"
  personBio={t.layout.bio}
  schema={schema}
  t={t.layout}
>
  <link slot="head" rel="preload" as="image" href={retratoPreload.src} fetchpriority="high" />

  <Nav slot="nav" lang={lang} t={t.nav} prefix={`/${lang}/`} />

  <!-- Hero: bio + retrato. El texto queda estático en lg (el disco se posiciona contra la
       sección): `isolate` + wash en -z-10 para que el wash no le pinte encima. -->
  <section
    data-about-hero
    class="relative isolate px-6 pt-[calc(var(--navbar-h)+3rem)] pb-16 md:pt-[calc(var(--navbar-h)+5rem)] md:pb-24 lg:pt-[var(--navbar-h)] lg:min-h-[min(100svh,860px)] lg:flex lg:items-center overflow-x-clip"
  >
    <div data-about-wash aria-hidden="true" class="about-wash pointer-events-none absolute inset-0 -z-10"></div>

    <div class="w-full max-w-7xl mx-auto">
      <!-- Texto (mobile: todo centrado y el disco arriba del H1). El rol ("Desarrollador web
           FullStack") no va como eyebrow: bordea el disco (arco de abajo); acá queda para lectores. -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left lg:max-w-[48%] lg:py-16">
        <p class="sr-only">{about.label}</p>

        <!-- Disco: la foto dentro del sol. Mobile: en flujo, arriba del H1. lg: absoluto contra la
             sección, centrado en alto y alineado al borde derecho del contenedor (7xl + px-6).
             El de afuera centra (translate) y hace el reveal (solo opacidad + blur); el de adentro
             lleva todo lo de GSAP (scroll: y + scale + opacidad; mouse: tilt de card-tilt.ts),
             así nada pisa el translate del centrado. -->
        <div
          data-about-reveal
          class="relative mt-8 mb-12 w-[78%] max-w-[380px] aspect-square lg:absolute lg:m-0 lg:max-w-none lg:w-[min(38vw,520px)] lg:right-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] lg:top-[calc(50%+var(--navbar-h)/2)] lg:-translate-y-1/2"
        >
          <div data-about-portrait data-tilt class="relative w-full h-full">
            <!-- sobreMi.webp es un recorte con alfa cuyo único corte duro es la espalda contra el
                 borde derecho del archivo: la figura va centrada y un poco más grande que el disco
                 (w 110%) para que ese corte caiga fuera del círculo; arriba entra la cabeza entera
                 y abajo el disco corta a la altura de las rodillas. -->
            <div class="absolute inset-0 rounded-full overflow-hidden bg-gradient-to-br from-accent-orange to-accent-pastel">
              <Image
                src={retrato}
                alt="Julián Recarte"
                width={1024}
                class="absolute left-[-9%] top-0 w-[110%] max-w-none h-auto"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <!-- Brillo que sigue al cursor (card-tilt.ts, igual que en las cards de proyectos). -->
              <span data-card-shine aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full opacity-0 transition-opacity duration-300"></span>
            </div>
            <!-- Arco del rol: una vez, por fuera del disco, desde un poco debajo de la mitad izquierda
                 hasta pasar apenas el tope. viewBox 100 = ancho del disco → escala con él;
                 textLength estira la frase al largo exacto del arco. -->
            <svg data-about-arc aria-hidden="true" viewBox="0 0 100 100" class="about-arc pointer-events-none absolute inset-0 overflow-visible">
              <defs>
                <path id="about-arc-path" d={arcPath} />
              </defs>
              <text class="fill-accent-ink">
                <textPath href="#about-arc-path" textLength={arcLength.toFixed(2)} lengthAdjust="spacing">{about.label}</textPath>
              </text>
            </svg>
          </div>
        </div>

        <h1 data-reveal-heading class="t-h1 font-medium text-copy dark:text-dark-copy text-balance mb-6">
          {about.title} <span class="text-accent-deep whitespace-nowrap">{about.highlight}</span>
        </h1>

        <p data-reveal class="t-lead text-copy dark:text-dark-copy max-w-xl text-balance mb-4">
          {about.introLead}
        </p>

        <p data-reveal class="t-body-lg text-copy/70 dark:text-dark-muted max-w-xl mb-10">
          {about.intro}
        </p>

        <div data-reveal class="flex flex-col sm:flex-row gap-3 items-center">
          <Button href={waHref} external>
            <WhatsAppIcon />
            {about.ctaPrimary}
          </Button>
          <Button href={`/${lang}/#proyectos`} variant="accent">{about.ctaSecondary}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack: banda editorial animada (decorativa; la lista accesible va en sr-only).
       Velocidad e inclinación reaccionan al scroll (about-intro.ts). -->
  <div
    data-reveal
    class="about-stack relative border-y line-hair py-4 md:py-5 overflow-hidden"
  >
    <div data-about-stack class="about-stack-track flex w-max" aria-hidden="true">
      {[0, 1].map(() => (
        <ul class="flex items-center">
          {[...about.stack, ...about.stack].map((item) => (
            <li class="about-stack-item flex items-center gap-6 px-3 whitespace-nowrap t-eyebrow text-copy/70 dark:text-dark-muted">
              {item}
              <span class="text-accent-orange text-[0.625rem]">✦</span>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <ul class="sr-only">
      {about.stack.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <!-- En resumen: bento -->
  <section class="relative px-6 py-16 md:py-24">
    <div class="max-w-7xl mx-auto">
      <SectionHeader label={about.factsLabel} title={about.factsTitle} highlight={about.factsHighlight} centered={false} />

      <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5" data-reveal-stagger>
        {about.facts.map((fact, i) => (
          <div
            class:list={[
              "about-card group flex flex-col gap-6 rounded-2xl border line-hair p-5 md:p-6",
              factSpan[i],
              factTint[i],
            ]}
          >
            <!-- Cabecera fija en todas las tarjetas: label a la izquierda, ícono a la derecha. -->
            <div class="flex items-center justify-between gap-4">
              <dt class="t-badge text-copy/70 dark:text-dark-muted">{fact.label}</dt>
              <span
                aria-hidden="true"
                class="flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-accent-orange/10 text-accent-orange transition-transform duration-500 group-hover:rotate-[8deg] group-hover:scale-110"
              >
                <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {fact.icon === "layers" ? (
                    <path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                  ) : fact.icon === "globe" ? (
                    <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  ) : fact.icon === "remote" ? (
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                  ) : (
                    <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
                  )}
                </svg>
              </span>
            </div>

            <!-- Contenido anclado abajo: con o sin contador, todas cierran a la misma línea. -->
            <dd class="mt-auto flex flex-col gap-3">
              {fact.stat && (
                <span class="t-h2 leading-none font-medium text-accent-deep tabular-nums">
                  <span data-count-to={fact.stat}>{fact.stat}</span>{fact.suffix}
                </span>
              )}
              {fact.value.includes("·") ? (
                <span class="flex flex-wrap gap-2">
                  {fact.value.split("·").map((chip) => (
                    <span class="t-badge rounded-full border line-hair px-3 py-1.5 text-copy/80 dark:text-dark-copy">
                      {chip.trim()}
                    </span>
                  ))}
                </span>
              ) : (
                <span class:list={[
                  "text-balance",
                  fact.stat ? "t-body text-copy/70 dark:text-dark-muted" : "t-h4 font-medium text-copy dark:text-dark-copy",
                ]}>
                  {fact.value}
                </span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Cómo trabajo: lista editorial (mismo lenguaje que Soluciones del home),
       en banda invertida para cortar la seguidilla de secciones beige. -->
  <section class="about-band surface-ink relative px-6 py-16 md:py-24">
    <div class="max-w-7xl mx-auto">
      <SectionHeader label={about.principlesLabel} title={about.principlesTitle} highlight={about.principlesHighlight} />

      <div data-reveal-stagger>
        {about.principles.map((item, i) => (
          <div class="group relative grid grid-cols-1 md:grid-cols-[minmax(0,360px)_1fr] gap-3 md:gap-12 py-8 md:py-10">
            <div data-solu-line aria-hidden="true" class="absolute top-0 left-0 right-0 h-px bg-white/[0.1] origin-left"></div>
            {i === about.principles.length - 1 && (
              <div data-solu-line aria-hidden="true" class="absolute bottom-0 left-0 right-0 h-px bg-white/[0.1] origin-left"></div>
            )}
            <div class="flex flex-row items-baseline gap-3">
              <span aria-hidden="true" class="t-index text-dark-muted/40 shrink-0">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <h3 class="t-h4 font-medium text-dark-copy transition-colors duration-300 group-hover:text-accent-orange">
                {item.title}
              </h3>
            </div>
            <p class="t-body text-dark-muted text-balance">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative px-6 py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <SectionHeader label={about.faqLabel} title={about.faqTitle} highlight={about.faqHighlight} />

      <div class="about-faq border-t line-hair" data-reveal-stagger>
        {about.faq.map((item, i) => (
          <details class="group border-b line-hair">
            <summary class="flex items-start gap-4 md:gap-6 cursor-pointer list-none py-6 t-body-lg font-medium text-copy dark:text-dark-copy hover:text-accent-ink transition-colors duration-300">
              <span aria-hidden="true" class="t-index shrink-0 pt-1 text-copy/30 dark:text-dark-muted/40 group-open:text-accent-ink transition-colors duration-300">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="flex-1">{item.q}</span>
              <span aria-hidden="true" class="flex items-center justify-center w-8 h-8 -mt-0.5 shrink-0 rounded-full border border-accent-orange/30 text-accent-orange transition-[transform,background-color,color] duration-300 group-open:rotate-45 group-open:bg-accent-orange group-open:text-white">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="about-faq-answer t-body pb-7 pl-10 md:pl-14 pr-4 text-copy/70 dark:text-dark-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre: CTA de contacto (sin id="contacto": el nav marca "Sobre mí" por ruta) -->
  <section class="relative px-6 py-20 md:py-28 overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 w-[600px] h-[600px] max-w-[150vw] rounded-full bg-accent-orange/[0.06] blur-3xl pointer-events-none dark:bg-accent-orange/[0.04]"
    ></div>

    <div class="relative max-w-3xl mx-auto flex flex-col items-center text-center">
      <SectionHeader label={about.closingLabel} title={about.closingTitle} highlight={about.closingHighlight} class="!mb-8" />

      <p data-reveal class="t-lead text-copy/70 dark:text-dark-muted max-w-xl mb-10 text-balance">
        {about.closingText}
      </p>

      <div data-reveal class="flex flex-col sm:flex-row gap-3 items-center">
        <Button href={waHref} external>
          <WhatsAppIcon />
          {about.closingWhatsapp}
        </Button>
        <Button href={mailtoLink(t.contact.emailSubject)} variant="outline">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M22 6L12 13 2 6M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" />
          </svg>
          {about.closingEmail}
        </Button>
      </div>

      <a
        href={`/${lang}/`}
        data-reveal
        class="inline-flex items-center gap-2 mt-12 py-3 t-link-quiet font-medium text-copy/70 dark:text-dark-muted hover:text-accent-ink transition-colors duration-300"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {about.backHome}
      </a>
    </div>
  </section>

  <Footer slot="footer" lang={lang} t={t.footer} />
</Layout>

<style>
  /* Wash del hero: dos focos suaves de la paleta que dan profundidad al retrato. */
  .about-wash {
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--clr-accent-orange) 14%, transparent), transparent 58%),
      radial-gradient(circle at 10% 72%, color-mix(in srgb, var(--clr-accent-pastel) 18%, transparent), transparent 52%);
  }

  :global(.dark) .about-wash {
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--clr-accent-orange) 10%, transparent), transparent 58%),
      radial-gradient(circle at 10% 72%, color-mix(in srgb, var(--clr-accent-pastel) 8%, transparent), transparent 52%);
  }

  /* Arco del rol: el tamaño va en unidades del viewBox (100 = ancho del disco), no en px, así
     escala con el círculo. word-spacing extra:
     textLength reparte el espacio igual entre todas las letras y las palabras se pegaban. */
  .about-arc text {
    font-size: 6px;
    word-spacing: 1.6px;
    font-weight: 500;
    text-transform: uppercase;
  }


  /* Banda del stack: ticker continuo con bordes desvanecidos. */
  .about-stack {
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .about-stack-track {
    animation: about-marquee 32s linear infinite;
  }

  .about-stack-item {
    transition: color var(--dur-base) ease;
  }

  @media (hover: hover) {
    .about-stack:hover .about-stack-track {
      animation-play-state: paused;
    }

    .about-stack-item:hover {
      color: var(--clr-accent-ink);
    }
  }

  @keyframes about-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Banda invertida ("Cómo trabajo"): el H2 del SectionHeader hereda el color. */
  .about-band {
    background-color: theme("colors.copy");
    color: theme("colors.dark.copy");
  }

  :global(.dark) .about-band {
    background-color: theme("colors.dark.card");
  }

  /* Bento: elevación suave al hover. */
  .about-card {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-color var(--dur-base) ease;
  }

  @media (hover: hover) {
    .about-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -20px rgba(var(--rgb-accent-orange), 0.25);
      border-color: rgba(var(--rgb-accent-orange), 0.25);
    }
  }

  /* FAQ: altura animada con ::details-content (mejora progresiva: sin
     soporte abre en seco, como antes). */
  .about-faq details {
    interpolate-size: allow-keywords;
  }

  .about-faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.45s allow-discrete;
  }

  .about-faq details[open]::details-content {
    block-size: auto;
  }

  .about-faq-answer {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.4s ease 0.05s,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
  }

  .about-faq details[open] .about-faq-answer {
    opacity: 1;
    transform: none;
  }
</style>
